<!-- Application-wide resources, kept out of App.xaml so tools can load them without starting the app. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Ultiviewer.App.Converters">
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisibility" />
    <conv:NonZeroToVisibilityConverter x:Key="ZeroToVisibility" Invert="True" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:SelectedValueBrushConverter x:Key="SelectedValueBrush" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="ViewModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); WPF types stay unambiguous without its global usings. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Ultiviewer</AssemblyName>
    <RootNamespace>Ultiviewer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ultiviewer.ico</ApplicationIcon>
    <!-- Self-contained so the exe runs without a machine-wide .NET 10 runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- WPF0001: Fluent ThemeMode is experimental. WFO0003: WinForms (tray icon only) prefers its own DPI API; WPF uses the manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor\Markdown.xshd" LogicalName="Ultiviewer.Markdown.xshd" />
    <Resource Include="Assets\ultiviewer.ico" />
    <!-- Preview shell and vendor libraries, served to WebView2 from <app>\Preview via a virtual host. -->
    <Content Include="PreviewAssets\**\*" Link="Preview\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ultiviewer.Core\Ultiviewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ultiviewer.Snapshot" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

<Window x:Class="Ultiviewer.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{Binding Title}" Width="1040" Height="700" MinWidth="640" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Margin="2,0,0,6" FontWeight="SemiBold" Text="Versions" />
            <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                       Text="A version is kept when you start editing, every few minutes while saving, and whenever another program changes the file." />
            <ListBox x:Name="List" ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Versions"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                            <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="14,0,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal">
                <RadioButton Content="Changes since this version" IsChecked="{Binding ShowChanges}" GroupName="Mode" AutomationProperties.Name="Show changes" />
                <RadioButton Margin="18,0,0,0" Content="Whole version" IsChecked="{Binding ShowVersion}" GroupName="Mode" AutomationProperties.Name="Show whole version" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Opacity="0.8" TextWrapping="Wrap" Text="{Binding Summary}" />
            <Border BorderThickness="1" BorderBrush="#30808080">
                <ae:TextEditor x:Name="Viewer" IsReadOnly="True" WordWrap="True" Padding="6,4,0,0"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13" AutomationProperties.Name="Version text" />
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="140" Content="Copy selected text" Click="OnCopy"
                    ToolTip="Copies the text selected on the right, or the whole version when nothing is selected" />
            <Button MinWidth="160" Margin="8,0,0,0" Content="Restore this version…" Click="OnRestore" IsEnabled="{Binding CanRestore}" />
            <Button MinWidth="90" Margin="8,0,0,0" Content="Close" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>

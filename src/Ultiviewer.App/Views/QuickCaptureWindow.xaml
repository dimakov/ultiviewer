<Window x:Class="Ultiviewer.App.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick note — Ultiviewer" Width="520" Height="300" MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="OnKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBox x:Name="Note" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="14" Padding="6" AutomationProperties.Name="Note" TextChanged="OnNoteChanged" />
            <TextBlock x:Name="Placeholder" Margin="12,9,0,0" IsHitTestVisible="False" Opacity="0.5" FontSize="14"
                       Text="Type a note…   Ctrl+Enter adds it · Esc closes" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Add to" />
            <ComboBox x:Name="Target" Width="190" Margin="8,0,0,0" AutomationProperties.Name="Add to">
                <ComboBoxItem Content="Today's daily note" />
                <ComboBoxItem Content="Inbox" />
            </ComboBox>
            <Button x:Name="ClipboardButton" Margin="12,0,0,0" Content="Paste clipboard" Click="OnPasteClipboard"
                    ToolTip="Adds the text on the clipboard to the note" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="Where" VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,0,260,0" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="80" Content="Add" IsDefault="False" Click="OnAdd" ToolTip="Ctrl+Enter" />
                <Button MinWidth="110" Margin="8,0,0,0" Content="Add and open" Click="OnAddAndOpen" ToolTip="Ctrl+Shift+Enter" />
                <Button MinWidth="70" Margin="8,0,0,0" Content="Close" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Ultiviewer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="720" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="96" Content="Save" IsDefault="True" Click="OnSave" />
            <Button MinWidth="96" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,0">
                <TextBlock Style="{StaticResource Section}" Text="Appearance" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Theme" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme" />
                    <TextBlock Grid.Row="1" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Editor font" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsEditable="True" ItemsSource="{Binding Fonts}"
                              Text="{Binding EditorFontFamily, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Editor font" />
                    <TextBlock Grid.Row="2" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Font size" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="90" Margin="0,8,0,0" HorizontalAlignment="Left"
                             Text="{Binding EditorFontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Font size" />
                    <TextBlock Grid.Row="3" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Live view font" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" IsEditable="True" ItemsSource="{Binding Fonts}"
                              Text="{Binding LiveFontFamily, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Live view font" />
                    <TextBlock Grid.Row="4" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Live view text width" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBox Width="90" Text="{Binding LiveMaxWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Live view text width" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="pixels (0 = full width)" />
                    </StackPanel>
                </Grid>
                <CheckBox Margin="0,10,0,0" Content="Word wrap" IsChecked="{Binding WordWrap}" />
                <CheckBox Margin="0,6,0,0" Content="Line numbers" IsChecked="{Binding ShowLineNumbers}" />
                <CheckBox Margin="0,6,0,0" Content="Show whitespace and line endings" IsChecked="{Binding ShowWhitespace}" />
                <CheckBox Margin="0,6,0,0" Content="Highlight the current line" IsChecked="{Binding HighlightCurrentLine}" />
                <CheckBox Margin="0,6,0,0" Content="Show the formatting toolbar (bold, headings, lists…) for notes" IsChecked="{Binding ShowFormatBar}" />

                <TextBlock Style="{StaticResource Section}" Text="Saving" />
                <CheckBox Content="Save notebook pages automatically (like OneNote)" IsChecked="{Binding AutosaveNotebookPages}" />
                <CheckBox Margin="0,6,0,0" Content="Save other files automatically too (otherwise Ctrl+S, like Notepad++)" IsChecked="{Binding AutosaveExternalFiles}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="Save after the last keystroke, in milliseconds" />
                    <TextBox Width="90" Text="{Binding AutosaveDelayMs, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Autosave delay in milliseconds" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" Content="Keep version history, at most one saved version every" IsChecked="{Binding KeepHistory}" />
                    <TextBox Width="50" Margin="6,0" IsEnabled="{Binding KeepHistory}" Text="{Binding HistoryIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="History interval in minutes" />
                    <TextBlock Style="{StaticResource Label}" Text="minutes (File → Page history)" />
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Search" />
                <CheckBox Content="Search text inside PDFs and pictures in notebooks" IsChecked="{Binding SearchAttachments}" />
                <CheckBox Margin="20,6,0,0" Content="Recognize text in pictures and scanned PDFs (Windows OCR, in the background)"
                          IsChecked="{Binding OcrImages}" IsEnabled="{Binding SearchAttachments}" />

                <TextBlock Style="{StaticResource Section}" Text="Daily notes and quick notes" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Notebook" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Notebooks}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding DailyNotesNotebook}" AutomationProperties.Name="Notebook for daily notes" />
                    <TextBlock Grid.Row="1" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Daily notes section" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="160" Margin="0,8,0,0" HorizontalAlignment="Left"
                             Text="{Binding DailyNotesFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Daily notes section" />
                    <TextBlock Grid.Row="2" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Daily note name" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBox Width="160" Text="{Binding DailyNoteFormat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Daily note name format" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="date format; _templates/Daily.md is used for new days" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Quick note shortcut" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBox Width="160" Text="{Binding QuickCaptureHotkey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quick note shortcut" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="works in every app; empty turns it off" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="180,4,0,0" Foreground="#D64545" Text="{Binding HotkeyProblem}" />
                <CheckBox Margin="0,6,0,0" Content="Keep running in the notification area when the window is closed (for the quick note shortcut)"
                          IsChecked="{Binding KeepRunningInTray}" />

                <TextBlock Style="{StaticResource Section}" Text="New pages and files" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Line endings" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LineEndings}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding DefaultLineEnding}" AutomationProperties.Name="Line endings for new files" />
                    <TextBlock Grid.Row="1" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Markdown opens in" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding DefaultMarkdownViewMode}" AutomationProperties.Name="Default view for Markdown" />
                    <TextBlock Grid.Row="2" Margin="0,8,12,0" Style="{StaticResource Label}" Text="Date / time format" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBox Width="120" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Date format" />
                        <TextBox Width="90" Margin="8,0,0,0" Text="{Binding TimeFormat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Time format" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding DatePreview}" />
                    </StackPanel>
                </Grid>
                <CheckBox Margin="0,10,0,0" Content="Write a UTF-8 byte-order mark (BOM) in new files" IsChecked="{Binding DefaultUtf8Bom}" />

                <TextBlock Style="{StaticResource Section}" Text="Windows integration" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Adds Ultiviewer to Explorer's &quot;Open with&quot; list for .md, .markdown and .txt files (for your user only). To make it the default, right-click a .md file → Open with → Choose another app → Ultiviewer → Always." />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button x:Name="AssociateButton" Content="Add to &quot;Open with&quot;" Click="OnAssociate" />
                    <Button Margin="8,0,0,0" Content="Remove" Click="OnUnassociate" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                               Text="Registered" Visibility="{Binding IsAssociated, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Open the settings folder" Click="OnOpenSettingsFolder" />

                <TextBlock Style="{StaticResource Section}" Text="Keyboard shortcuts" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="To change a shortcut, add it to &quot;shortcuts&quot; in settings.json, e.g. &quot;DuplicateLine&quot;: &quot;Ctrl+Alt+D&quot; (an empty value removes it), then restart." />
                <ListView Margin="0,8,0,20" MaxHeight="320" ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="Keyboard shortcuts">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220" Header="Command" DisplayMemberBinding="{Binding Description}" />
                            <GridViewColumn Width="170" Header="Shortcut" DisplayMemberBinding="{Binding Gesture}" />
                            <GridViewColumn Width="170" Header="Name in settings.json" DisplayMemberBinding="{Binding Name}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

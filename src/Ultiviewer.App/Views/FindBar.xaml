<UserControl x:Class="Ultiviewer.App.Views.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BarToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>
    <Border Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="#30808080">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="FindBox" Grid.Row="0" Grid.Column="0" AutomationProperties.Name="Find"
                     TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,0" Orientation="Horizontal">
                <ToggleButton x:Name="MatchCase" Style="{StaticResource BarToggle}" Content="Aa" ToolTip="Match case" Click="OnOptionChanged" />
                <ToggleButton x:Name="WholeWord" Style="{StaticResource BarToggle}" Content="W" ToolTip="Whole word" Click="OnOptionChanged" />
                <ToggleButton x:Name="UseRegex" Style="{StaticResource BarToggle}" Content=".*" ToolTip="Regular expression" Click="OnOptionChanged" />
                <ToggleButton x:Name="InSelection" Style="{StaticResource BarToggle}" FontFamily="{StaticResource IconFont}" Content="&#xE8B3;"
                              ToolTip="Find in selection" Click="OnInSelectionChanged" />
                <TextBlock x:Name="CountText" MinWidth="90" Margin="8,0" VerticalAlignment="Center" Opacity="0.75" />
                <Button Style="{StaticResource BarButton}" FontFamily="{StaticResource IconFont}" Content="&#xE70E;" ToolTip="Previous match (Shift+F3)" Click="OnPrevious" />
                <Button Style="{StaticResource BarButton}" FontFamily="{StaticResource IconFont}" Content="&#xE70D;" ToolTip="Next match (F3)" Click="OnNext" />
                <ToggleButton x:Name="ReplaceToggle" Style="{StaticResource BarToggle}" FontFamily="{StaticResource IconFont}" Content="&#xE8AB;"
                              ToolTip="Show replace (Ctrl+H)" Click="OnReplaceToggle" />
                <Button Style="{StaticResource BarButton}" FontFamily="{StaticResource IconFont}" FontSize="10" Content="&#xE711;" ToolTip="Close (Esc)" Click="OnClose" />
            </StackPanel>

            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" AutomationProperties.Name="Replace with"
                     Visibility="Collapsed" PreviewKeyDown="OnReplaceKeyDown" />
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Orientation="Horizontal" Visibility="Collapsed">
                <Button Style="{StaticResource BarButton}" Content="Replace" ToolTip="Replace this match (Enter in the replace box)" Click="OnReplaceOne" />
                <Button Style="{StaticResource BarButton}" Content="Replace all" ToolTip="Replace all matches (one undo step)" Click="OnReplaceAll" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

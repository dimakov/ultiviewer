<UserControl x:Class="Ultiviewer.App.Views.LinksPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="Row">
            <StackPanel Margin="2,3" Background="Transparent">
                <TextBlock x:Name="Title" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Location, Mode=OneWay}" FontWeight="Normal" FontSize="11" />
                </TextBlock>
                <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="#D64545" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,12,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,8">
            <TextBlock Margin="8,10" TextWrapping="Wrap" Opacity="0.6" Text="{Binding LinksMessage}" />

            <TextBlock Style="{StaticResource Header}">
                <Run Text="Linked from" /><Run Text="  " /><Run Text="{Binding Backlinks.Count, Mode=OneWay}" FontWeight="Normal" />
            </TextBlock>
            <ListBox BorderThickness="0" Background="Transparent" ItemsSource="{Binding Backlinks}" ItemTemplate="{StaticResource Row}"
                     AutomationProperties.Name="Pages linking here" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnRowClicked" KeyDown="OnRowKeyDown" PreviewMouseWheel="OnInnerWheel" />

            <TextBlock Style="{StaticResource Header}">
                <Run Text="Links on this page" /><Run Text="  " /><Run Text="{Binding OutgoingLinks.Count, Mode=OneWay}" FontWeight="Normal" />
            </TextBlock>
            <ListBox BorderThickness="0" Background="Transparent" ItemsSource="{Binding OutgoingLinks}" ItemTemplate="{StaticResource Row}"
                     AutomationProperties.Name="Links on this page" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnRowClicked" KeyDown="OnRowKeyDown" PreviewMouseWheel="OnInnerWheel" />

            <TextBlock Style="{StaticResource Header}">
                <Run Text="Unlinked mentions" /><Run Text="  " /><Run Text="{Binding UnlinkedMentions.Count, Mode=OneWay}" FontWeight="Normal" />
            </TextBlock>
            <ListBox BorderThickness="0" Background="Transparent" ItemsSource="{Binding UnlinkedMentions}"
                     AutomationProperties.Name="Unlinked mentions" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     PreviewMouseLeftButtonUp="OnRowClicked" KeyDown="OnRowKeyDown" PreviewMouseWheel="OnInnerWheel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" MinHeight="0" VerticalAlignment="Center"
                                    Content="Link" ToolTip="Turn this mention into a [[link]]" Click="OnLinkMention" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Row}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>

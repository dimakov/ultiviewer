<Window x:Class="Ultiviewer.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="1020" Height="820" MinWidth="640" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="12,10,12,6" Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Paper" />
            <ComboBox x:Name="Paper" Width="110" SelectedIndex="0" AutomationProperties.Name="Paper size">
                <ComboBoxItem Content="A4" />
                <ComboBoxItem Content="Letter" />
            </ComboBox>
            <ComboBox x:Name="Orientation" Width="120" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="Orientation">
                <ComboBoxItem Content="Portrait" />
                <ComboBoxItem Content="Landscape" />
            </ComboBox>
            <ComboBox x:Name="Margins" Width="130" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="Margins">
                <ComboBoxItem Content="Normal margins" />
                <ComboBoxItem Content="Narrow margins" />
                <ComboBoxItem Content="No margins" />
            </ComboBox>
            <CheckBox x:Name="TitlePages" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True"
                      Content="Page titles as headings" Checked="OnContentOptionChanged" Unchecked="OnContentOptionChanged" />
            <CheckBox x:Name="BreakPages" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True"
                      Content="Each page on a new sheet" Checked="OnContentOptionChanged" Unchecked="OnContentOptionChanged" />
        </WrapPanel>
        <Grid DockPanel.Dock="Bottom" Margin="12,8,12,12">
            <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="0,0,420,0" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="110" Content="Save as HTML…" Click="OnSaveHtml" />
                <Button MinWidth="110" Margin="8,0,0,0" Content="Save as PDF…" Click="OnSavePdf" />
                <Button MinWidth="90" Margin="8,0,0,0" Content="Print…" Click="OnPrint" />
                <Button MinWidth="80" Margin="8,0,0,0" Content="Close" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </Grid>
        <Border x:Name="PreviewHost" BorderThickness="0,1" BorderBrush="#30808080" />
    </DockPanel>
</Window>

<UserControl x:Class="Ultiviewer.App.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ultiviewer.App.ViewModels"
             xmlns:views="clr-namespace:Ultiviewer.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="8,6,4,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,0,0"
                    Background="Transparent" BorderThickness="0" Focusable="False"
                    FontFamily="{StaticResource IconFont}" FontSize="11" Content="&#xE711;"
                    ToolTip="Close search (Esc)" AutomationProperties.Name="Close search" Command="{Binding CloseSearchCommand}" />
            <TextBlock DockPanel.Dock="Right" MinWidth="170" Margin="10,0,6,0" VerticalAlignment="Center" Opacity="0.75"
                       Text="{Binding SearchStatus}" TextTrimming="CharacterEllipsis" />
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="6,0,0,0" ItemsSource="{Binding SearchScopes}"
                      SelectedItem="{Binding SearchScope}" AutomationProperties.Name="Search scope" />
            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE721;" />
            <ComboBox x:Name="QueryBox" IsEditable="True" IsTextSearchEnabled="False"
                      AutomationProperties.Name="Search notebooks"
                      ToolTip="Words (all must appear) · &quot;exact phrase&quot; · a OR b · -exclude · #tag · is:todo / is:done"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding RecentSearches}"
                      PreviewKeyDown="OnQueryKeyDown" />
        </DockPanel>

        <TreeView x:Name="Results" Grid.Row="1" Margin="4,0,4,4" BorderThickness="0" Background="Transparent"
                  ItemsSource="{Binding SearchResults}" AutomationProperties.Name="Search results"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  KeyDown="OnResultsKeyDown" PreviewMouseLeftButtonUp="OnResultsMouseUp">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:SearchPageViewModel}" ItemsSource="{Binding Lines}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE8A5;" Opacity="0.75" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6" Text="{Binding Location}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6" Text="{Binding MatchCount, StringFormat=({0})}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type vm:SearchLineViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="44" Margin="0,0,10,0" TextAlignment="Right" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"
                                   Text="{Binding Line}" />
                        <views:HighlightedText FontFamily="Cascadia Mono, Consolas" Segments="{Binding Segments}" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>

<Window x:Class="Ultiviewer.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="Input" AutomationProperties.LabeledBy="{Binding ElementName=LabelText}" TextChanged="OnTextChanged" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#D13438" Visibility="Collapsed" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OkButton" MinWidth="88" Content="OK" IsDefault="True" Click="OnOk" />
            <Button MinWidth="88" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="Ultiviewer.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command palette" Width="640" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown">
    <Border BorderThickness="1" BorderBrush="#40808080" Padding="10">
        <StackPanel>
            <TextBox x:Name="Query" AutomationProperties.Name="Command" TextChanged="OnQueryChanged" />
            <TextBlock Margin="2,6,0,4" FontSize="11" Opacity="0.6" Text="Type to filter commands · ↑↓ to choose · Enter to run · Esc to close" />
            <ListBox x:Name="Items" MaxHeight="440" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Commands" MouseUp="OnItemsMouseUp"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,2">
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,2,0" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Text="{Binding Gesture}" />
                            <TextBlock DockPanel.Dock="Left" Width="16" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Text="{Binding CheckGlyph}" />
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Location, Mode=OneWay}" Foreground="Gray" /><Run Text="{Binding Separator, Mode=OneWay}" Foreground="Gray" /><Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Margin="2,4" Opacity="0.6" Text="No matching command" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>

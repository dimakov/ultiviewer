<UserControl x:Class="Ultiviewer.App.Views.NotebookTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ultiviewer.App.ViewModels">
    <TreeView x:Name="Tree"
              ItemsSource="{Binding Notebooks}"
              AllowDrop="True"
              BorderThickness="0"
              Background="Transparent"
              AutomationProperties.Name="Notebooks"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              SelectedItemChanged="OnSelectedItemChanged"
              KeyDown="OnKeyDown"
              PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
              PreviewMouseMove="OnPreviewMouseMove"
              PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
              MouseDoubleClick="OnMouseDoubleClick"
              DragOver="OnDragOver"
              DragLeave="OnDragLeave"
              Drop="OnDrop"
              ContextMenuOpening="OnContextMenuOpening">
        <TreeView.ContextMenu>
            <ContextMenu />
        </TreeView.ContextMenu>
        <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <EventSetter Event="Selected" Handler="OnItemSelected" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnItemGotKeyboardFocus" />
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="Icon"
                               Width="16" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Opacity="0.75"
                               Text="{Binding Glyph}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Name}"
                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBox MinWidth="170" Padding="4,1"
                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                             KeyDown="OnEditKeyDown"
                             LostKeyboardFocus="OnEditLostFocus"
                             IsVisibleChanged="OnEditVisibleChanged"
                             Loaded="OnEditLoaded" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                        <Setter TargetName="Icon" Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                        <Setter TargetName="Icon" Property="Opacity" Value="1" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>

<Window x:Class="Ultiviewer.App.Views.QuickOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to page" Width="640" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown">
    <Border BorderThickness="1" BorderBrush="#40808080" Padding="10">
        <StackPanel>
            <TextBox x:Name="Query" AutomationProperties.Name="Page title" TextChanged="OnQueryChanged" />
            <TextBlock Margin="2,6,0,4" FontSize="11" Opacity="0.6" Text="Type to filter pages · ↑↓ to choose · Enter to open · Esc to close" />
            <ListBox x:Name="Items" MaxHeight="400" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Pages" MouseUp="OnItemsMouseUp"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,1">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="Ultiviewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ultiviewer.App.Views"
        xmlns:editor="clr-namespace:Ultiviewer.App.Editor"
        Title="{Binding WindowTitle}" Width="1280" Height="820" MinWidth="640" MinHeight="400"
        Icon="pack://application:,,,/Assets/ultiviewer.ico"
        AllowDrop="True" Drop="OnWindowDrop">
    <Window.Resources>
        <Style x:Key="ViewModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New _notebook…" Command="{Binding NewNotebookCommand}" />
                <MenuItem Header="Open folder as note_book…" Command="{Binding OpenNotebookFolderCommand}" />
                <Separator />
                <MenuItem Header="New _file" Command="{Binding NewFileCommand}" InputGestureText="Ctrl+T" />
                <MenuItem Header="_Open file…" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Reopen closed _tab" Command="{Binding ReopenClosedCommand}" InputGestureText="Ctrl+Shift+T" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _as…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Alt+S" />
                <MenuItem Header="Save a_ll" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="_Reload from disk" Command="{Binding ReloadCommand}" />
                <Separator />
                <MenuItem Header="_Close tab" Command="{Binding CloseCommand}" InputGestureText="Ctrl+W" />
                <MenuItem Header="Close all tabs" Command="{Binding CloseAllCommand}" />
                <Separator />
                <MenuItem Header="Se_ttings…" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+," />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem x:Name="EditMenu" Header="_Edit">
                <MenuItem Command="ApplicationCommands.Undo" />
                <MenuItem Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Command="ApplicationCommands.Cut" />
                <MenuItem Command="ApplicationCommands.Copy" />
                <MenuItem Command="ApplicationCommands.Paste" />
                <MenuItem Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Command="editor:EditorCommands.Find" />
                <MenuItem Command="editor:EditorCommands.Replace" />
                <MenuItem Command="editor:EditorCommands.FindNext" />
                <MenuItem Command="editor:EditorCommands.FindPrevious" />
                <MenuItem Command="editor:EditorCommands.GoToLine" />
                <Separator />
                <MenuItem Header="_Line operations">
                    <MenuItem Command="editor:EditorCommands.DuplicateLine" />
                    <MenuItem Command="editor:EditorCommands.DeleteLine" />
                    <MenuItem Command="editor:EditorCommands.MoveLineUp" />
                    <MenuItem Command="editor:EditorCommands.MoveLineDown" />
                    <MenuItem Command="editor:EditorCommands.JoinLines" />
                    <Separator />
                    <MenuItem Command="editor:EditorCommands.SortAscending" />
                    <MenuItem Command="editor:EditorCommands.SortDescending" />
                    <MenuItem Command="editor:EditorCommands.RemoveDuplicateLines" />
                    <MenuItem Command="editor:EditorCommands.RemoveEmptyLines" />
                    <MenuItem Command="editor:EditorCommands.TrimTrailing" />
                </MenuItem>
                <MenuItem Header="Convert _case">
                    <MenuItem Command="editor:EditorCommands.UpperCase" />
                    <MenuItem Command="editor:EditorCommands.LowerCase" />
                    <MenuItem Command="editor:EditorCommands.TitleCase" />
                </MenuItem>
                <MenuItem Header="_Bookmarks">
                    <MenuItem Command="editor:EditorCommands.ToggleBookmark" />
                    <MenuItem Command="editor:EditorCommands.NextBookmark" />
                    <MenuItem Command="editor:EditorCommands.PreviousBookmark" />
                    <MenuItem Command="editor:EditorCommands.ClearBookmarks" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Command="editor:EditorCommands.ToggleTask" />
                <MenuItem Command="editor:EditorCommands.InsertDate" />
                <MenuItem Command="editor:EditorCommands.InsertTime" />
                <MenuItem Command="editor:EditorCommands.InsertDateTime" />
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_View">
                <MenuItem Header="_Edit only" Command="{Binding SetViewModeCommand}" CommandParameter="Edit" />
                <MenuItem Header="_Split: editor and preview" Command="{Binding SetViewModeCommand}" CommandParameter="Split" />
                <MenuItem Header="_Preview only" Command="{Binding SetViewModeCommand}" CommandParameter="Preview" />
                <MenuItem Header="Cycle view mode" Command="{Binding CycleViewModeCommand}" InputGestureText="Ctrl+Shift+V" />
                <Separator />
                <MenuItem Header="_Word wrap" IsCheckable="True" IsChecked="{Binding WordWrap}" />
                <MenuItem Header="_Line numbers" IsCheckable="True" IsChecked="{Binding ShowLineNumbers}" />
                <MenuItem Header="Show _whitespace" IsCheckable="True" IsChecked="{Binding ShowWhitespace}" />
                <MenuItem Header="_Highlight current line" IsCheckable="True" IsChecked="{Binding HighlightCurrentLine}" />
                <Separator />
                <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="_Reset zoom" Command="{Binding ZoomResetCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="_Theme">
                    <MenuItem Header="_System" IsCheckable="True" IsChecked="{Binding IsThemeSystem, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                    <MenuItem Header="_Light" IsCheckable="True" IsChecked="{Binding IsThemeLight, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="_Dark" IsCheckable="True" IsChecked="{Binding IsThemeDark, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Find in notebooks…" Click="OnFindInNotebooks" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="_Go to page…" Command="{Binding QuickOpenCommand}" InputGestureText="Ctrl+E" />
            </MenuItem>
            <MenuItem x:Name="GoMenu" Header="_Go" SubmenuOpened="OnGoMenuOpened">
                <MenuItem Header="(loading)" />
            </MenuItem>
            <MenuItem Header="_Notebook">
                <MenuItem Header="New _page" Command="{Binding NewPageCommand}" InputGestureText="Ctrl+N" />
                <MenuItem x:Name="TemplatesMenu" Header="New page from _template" SubmenuOpened="OnTemplatesMenuOpened">
                    <MenuItem Header="(loading)" />
                </MenuItem>
                <MenuItem Header="New _section" Command="{Binding NewSectionCommand}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="New sub_page" Command="{Binding NewSubpageCommand}" />
                <Separator />
                <MenuItem Header="_Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" />
                <MenuItem Header="Open in _Explorer" Command="{Binding RevealInExplorerCommand}" />
                <Separator />
                <MenuItem Header="Re_fresh" Command="{Binding RefreshCommand}" InputGestureText="F5" />
                <MenuItem Header="_Close notebook" Command="{Binding CloseNotebookCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="Open the error _log" Click="OnOpenErrorLog" />
                <Separator />
                <MenuItem Header="_About Ultiviewer" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Padding="6,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" MinWidth="90">
                <TextBlock Text="{Binding SaveStatus}" Opacity="0.85" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="8,0" VerticalAlignment="Center">
                        <Run Text="Ln" /> <Run Text="{Binding CaretLine, Mode=OneWay}" /><Run Text=", Col" /> <Run Text="{Binding CaretColumn, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding SelectionLength, StringFormat={}{0} selected}"
                               Visibility="{Binding SelectionLength, Converter={StaticResource NonZeroToVisibility}}" />
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding WordCount, StringFormat={}{0} words}"
                               Visibility="{Binding ActiveTab.IsMarkdown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding ZoomPercent, StringFormat={}{0}%}" ToolTip="Zoom (Ctrl+wheel)" />
                    <Button x:Name="EncodingButton" Style="{StaticResource StatusButton}" Content="{Binding ActiveTab.Format.EncodingName}" ToolTip="Encoding" Click="OnEncodingClick" />
                    <Button x:Name="LineEndingButton" Style="{StaticResource StatusButton}" Content="{Binding ActiveTab.Format.LineEndingName}" ToolTip="Line endings" Click="OnLineEndingClick" />
                    <Button x:Name="LanguageButton" Style="{StaticResource StatusButton}" Content="{Binding ActiveTab.Language}" ToolTip="Language (syntax highlighting)" Click="OnLanguageClick" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="LeftTabs" Grid.Column="0" Margin="4,0,0,4" BorderThickness="0" Background="Transparent">
                <TabItem Header="Notebooks" AutomationProperties.Name="Notebooks pane">
                    <Grid>
                        <views:NotebookTree x:Name="Tree" Margin="0,4,0,0" />
                        <StackPanel Margin="20" VerticalAlignment="Center"
                                    Visibility="{Binding HasNotebooks, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="No notebooks yet" />
                            <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Opacity="0.8"
                                       Text="A notebook is a folder of Markdown files. Create a new one, or open a folder you already have." />
                            <Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Content="Create a notebook…" Command="{Binding NewNotebookCommand}" />
                            <Button HorizontalAlignment="Stretch" Content="Open a folder…" Command="{Binding OpenNotebookFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Tags" AutomationProperties.Name="Tags pane">
                    <views:TagsPane />
                </TabItem>
                <TabItem Header="To-do" AutomationProperties.Name="To-do pane">
                    <views:TodoPane />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <Grid x:Name="DocumentArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ResultsRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:TabStrip x:Name="Tabs" />
                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Orientation="Horizontal"
                                Visibility="{Binding ActiveViewMode, Converter={StaticResource NullToVisibility}}">
                        <Button Style="{StaticResource ViewModeButton}" Content="Edit" ToolTip="Editor only (Ctrl+Shift+V cycles)"
                                Command="{Binding SetViewModeCommand}" CommandParameter="Edit"
                                Background="{Binding ActiveViewMode, Converter={StaticResource SelectedValueBrush}, ConverterParameter=Edit}" />
                        <Button Style="{StaticResource ViewModeButton}" Content="Split" ToolTip="Editor and preview side by side (Ctrl+Shift+V cycles)"
                                Command="{Binding SetViewModeCommand}" CommandParameter="Split"
                                Background="{Binding ActiveViewMode, Converter={StaticResource SelectedValueBrush}, ConverterParameter=Split}" />
                        <Button Style="{StaticResource ViewModeButton}" Content="Preview" ToolTip="Preview only (Ctrl+Shift+V cycles)"
                                Command="{Binding SetViewModeCommand}" CommandParameter="Preview"
                                Background="{Binding ActiveViewMode, Converter={StaticResource SelectedValueBrush}, ConverterParameter=Preview}" />
                    </StackPanel>
                </Grid>
                <views:EditorHost x:Name="EditorView" Grid.Row="1"
                                  Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           Text="Select a page in the tree, or press Ctrl+N for a new page"
                           Visibility="{Binding HasTabs, Converter={StaticResource InverseBoolToVisibility}}" />
                <GridSplitter x:Name="ResultsSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Focusable="False"
                              Visibility="{Binding IsSearchPanelOpen, Converter={StaticResource BoolToVisibility}}" />
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#30808080"
                        Visibility="{Binding IsSearchPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <views:SearchPanel x:Name="SearchView" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

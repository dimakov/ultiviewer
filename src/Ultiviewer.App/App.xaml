<Application x:Class="Ultiviewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ultiviewer.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVisibility" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:SelectedValueBrushConverter x:Key="SelectedValueBrush" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
